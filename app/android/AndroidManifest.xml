<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="de.homelab.jarvis"
    android:versionCode="23"
    android:versionName="4.6.1">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Seit 3.7: Update-Knopf gibt die neue APK an Androids Installer (PackageInstaller) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 11+: ohne diese Abfrage sieht die App den Spracherkennungsdienst nicht -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <application
        android:label="Jarvis"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/netz"
        android:theme="@style/Jarvis">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Seit 4.0: Kopplungslink jarvis://koppeln?adresse=...&code=... (von der Kopplungsseite der Bruecke) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jarvis" android:host="koppeln" />
            </intent-filter>
        </activity>
        <!-- Seit 4.3: Ablage fuer "Foto aufnehmen" (genau eine Datei im Cache, nicht exportiert; die Kamera-App bekommt
             nur fuer den einen Aufruf Schreibrecht) -->
        <provider
            android:name=".KameraAblage"
            android:authorities="de.homelab.jarvis.kamera"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
