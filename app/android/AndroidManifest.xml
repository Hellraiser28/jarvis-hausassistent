<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="de.homelab.jarvis"
    android:versionCode="46"
    android:versionName="4.15.1">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Seit 4.15.1: Netzwechsel erkennen, danach beweist sich die Bruecke neu, bevor das Token wieder rausgeht -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Seit 3.7: Update-Knopf gibt die neue APK an Androids Installer (PackageInstaller) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Handy-Steuerung Stufe 1 (Prototyp 29.10.2026): Wecker und Timer stellen (normale Berechtigung, keine Abfrage) -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Seit 30.10.2026: "Ruf Anna an" nach gesprochenem Ja. Kontakte werden nur auf dem Handy gelesen (nie zur Bruecke),
         beides wird erst beim Einschalten von "Anrufen und WhatsApp nach Ja" zur Laufzeit erfragt. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Android 11+: ohne diese Abfrage sieht die App den Spracherkennungsdienst nicht -->
    <queries>
        <!-- Seit 4.15.1: Bestaetigung des Paketinstallers vor dem Start pruefen (System-App?) -->
        <intent>
            <action android:name="android.content.pm.action.CONFIRM_INSTALL" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Handy-Steuerung: "Oeffne Spotify" sucht die App nach ihrem Namen unter den startbaren Apps -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application
        android:label="Jarvis"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/netz"
        android:theme="@style/Jarvis">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Seit 4.0: Kopplungslink jarvis://koppeln?adresse=...&code=... (von der Kopplungsseite der Bruecke) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jarvis" android:host="koppeln" />
            </intent-filter>
        </activity>
        <!-- Seit 4.15 (Ideen-Paket A1): Teilen an Jarvis. Eine eigene Aktivitaet ohne Oberflaeche nimmt Text, Links und Bilder
             aus dem Teilen-Menue an und reicht sie an die MainActivity in Jarvis' eigener Aufgabe weiter; direkt auf der
             MainActivity entstuende eine zweite Jarvis-Instanz in der Aufgabe der teilenden App. Gesendet wird nichts. -->
        <activity
            android:name=".TeilenEmpfang"
            android:label="Jarvis"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <!-- Seit 4.15 (Ideen-Paket A2): Schnelleinstellungs-Kachel "Jarvis"; oeffnet die App, die sofort zuhoert.
             Nur das System darf sie binden (BIND_QUICK_SETTINGS_TILE). Symbol: die monochrome Ebene des App-Symbols. -->
        <service
            android:name=".JarvisKachel"
            android:label="Jarvis"
            android:icon="@mipmap/ic_launcher_monochrome"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Seit 4.3: Ablage fuer "Foto aufnehmen" (genau eine Datei im Cache, nicht exportiert; die Kamera-App bekommt
             nur fuer den einen Aufruf Schreibrecht) -->
        <provider
            android:name=".KameraAblage"
            android:authorities="de.homelab.jarvis.kamera"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- Handy-Steuerung Stufe 2 (PROTOTYP 29.10.2026, Standard aus): Bedienungshilfe. Wirkt erst, wenn die Person
             sie in den Android-Einstellungen einschaltet (bei einer per Datei installierten App vorher "Eingeschraenkte
             Einstellungen zulassen"), die Bruecke das Geraet freigibt und die Person jeder Aufgabe zustimmt. -->
        <service
            android:name=".JarvisBedienung"
            android:label="@string/bedienung_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/bedienung" />
        </service>
    </application>
</manifest>
