LangString T_VERB_ADRESSE ${LANG_ENGLISH} "Address of the Jarvis host (e.g. 192.168.1.20 or http://jarvis.local:8770):"
LangString T_VERB_CODE ${LANG_GERMAN} "Kopplungscode (z. B. ABCD-EFGH):"
LangString T_VERB_CODE ${LANG_ENGLISH} "Pairing code (e.g. ABCD-EFGH):"
